<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Comercium.App">
    <SolidColorBrush x:Key="Canvas" Color="#F3F6FA" />
    <SolidColorBrush x:Key="Navy" Color="#112640" />
    <SolidColorBrush x:Key="Ink" Color="#192C45" />
    <SolidColorBrush x:Key="Muted" Color="#536981" />
    <SolidColorBrush x:Key="Line" Color="#DCE5EF" />
    <SolidColorBrush x:Key="Blue" Color="#075BBB" />
    <SolidColorBrush x:Key="PaleBlue" Color="#E7F2FF" />
    <SolidColorBrush x:Key="Red" Color="#A52735" />
    <BooleanToVisibilityConverter x:Key="VisibleWhen" />
    <local:DisplayConverter x:Key="Display" />

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Canvas}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="29" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="Feedback" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="#176147" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Red}" /></DataTrigger>
            <DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Margin" Value="0,9,0,4" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="7,4" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="{StaticResource PaleBlue}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5AA8FB" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Blue}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#203854" />
        <Setter Property="Foreground" Value="#EFF6FF" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="#F7FAFE" />
        <Setter Property="RowHeight" Value="33" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#EAF0F8" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
