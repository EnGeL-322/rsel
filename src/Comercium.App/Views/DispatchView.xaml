<UserControl x:Class="Comercium.App.Views.DispatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="2*" /><RowDefinition Height="12" /><RowDefinition Height="3*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                    <Button DockPanel.Dock="Right" Content="Actualizar" Command="{Binding Reload}" />
                    <CheckBox DockPanel.Dock="Right" Content="Historial reciente" IsChecked="{Binding History}" VerticalAlignment="Center" Margin="6,0,9,0" />
                    <TextBlock Text="Pedidos" Style="{StaticResource Section}" VerticalAlignment="Center" Margin="0" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Pedidos en tienda">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding Id}" Width="80" />
                        <DataGridTextColumn Header="Venta registrada" Binding="{Binding AtUtc, Converter={StaticResource Display}}" Width="*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Status, Converter={StaticResource Display}}" Width="155" />
                        <DataGridTextColumn Header="Verificados" Binding="{Binding Verified}" Width="93" />
                        <DataGridTextColumn Header="Líneas" Binding="{Binding Total}" Width="65" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Progress}" Style="{StaticResource Section}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Timeline}" Style="{StaticResource Hint}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button Content="Imprimir lista" Command="{Binding Print}" Margin="0,0,6,0" />
                        <Button Content="{Binding VerifyLabel}" Command="{Binding Verify}" Margin="0,0,6,0" />
                        <Button Content="{Binding AdvanceLabel}" Command="{Binding Advance}" Style="{StaticResource Primary}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Feedback}" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Order.Lines}" SelectedItem="{Binding SelectedLine}" AutomationProperties.Name="Productos por verificar">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="85" />
                        <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Ubicación" Binding="{Binding Location}" Width="*" />
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="75" />
                        <DataGridTextColumn Header="Verificación" Binding="{Binding Verified, Converter={StaticResource Display}, ConverterParameter=pick}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
