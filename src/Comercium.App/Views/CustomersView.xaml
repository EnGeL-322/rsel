<UserControl x:Class="Comercium.App.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="264" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="12" /><RowDefinition /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Nombre, documento o teléfono" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                    <Button DockPanel.Dock="Right" Content="Nuevo" Command="{Binding New}" Style="{StaticResource Primary}" Margin="7,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding Find}" Margin="7,0,0,0" />
                    <TextBox Text="{Binding Term, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar nombre, documento o teléfono">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Find}" /></TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Directorio de clientes">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Customer.Name}" Width="*" MinWidth="95" />
                        <DataGridTextColumn Header="Documento" Binding="{Binding Customer.Document}" Width="105" />
                        <DataGridTextColumn Header="Tarifa" Binding="{Binding Customer.Tariff}" Width="89" />
                        <DataGridTextColumn Header="Compras" Binding="{Binding Purchases}" Width="78" />
                        <DataGridTextColumn Header="Acumulado" Binding="{Binding Spent, Converter={StaticResource Display}, ConverterParameter=money}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Guardar comprobante" Command="{Binding SaveReceipt}" />
                    <TextBlock Text="Compras del cliente" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding Sale}" AutomationProperties.Name="Compras del cliente">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Venta" Binding="{Binding Id}" Width="70" />
                        <DataGridTextColumn Header="Fecha" Binding="{Binding AtUtc, Converter={StaticResource Display}}" Width="*" MinWidth="115" />
                        <DataGridTextColumn Header="Pago" Binding="{Binding Method}" Width="102" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource Display}, ConverterParameter=money}" Width="95" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Voided, Converter={StaticResource Display}, ConverterParameter=sale}" Width="99" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Ficha del cliente" Style="{StaticResource Section}" />
                    <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Form.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="140" AutomationProperties.Name="Nombre del cliente" />
                    <TextBlock Text="Documento (opcional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Form.Document, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AutomationProperties.Name="Documento del cliente" />
                    <TextBlock Text="Teléfono (opcional)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Form.Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Teléfono del cliente" />
                    <CheckBox Content="Tarifa mayorista" IsChecked="{Binding Form.Wholesale}" Margin="0,11,0,0" />
                    <CheckBox Content="Cliente activo" IsChecked="{Binding Form.Active}" Margin="0,9,0,0" />
                    <Button Content="Guardar cliente" Command="{Binding Save}" Style="{StaticResource Primary}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Feedback}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
