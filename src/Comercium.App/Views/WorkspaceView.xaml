<UserControl x:Class="Comercium.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="197" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Navy}" Padding="16,20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,28">
                    <Border Background="#2178D7" CornerRadius="7" Width="32" Height="32" Margin="0,0,9,0">
                        <TextBlock Text="C" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Comercium" Foreground="White" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding User}" Foreground="#C1D7EE" FontSize="13" Margin="5,6,0,10" />
                    <Button Content="Mi cuenta" Command="{Binding GoAccount}" Style="{StaticResource Nav}" />
                    <Button Content="Cerrar sesión" Command="{Binding SignOut}" Style="{StaticResource Nav}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Button Content="Inicio" Command="{Binding GoDashboard}" Style="{StaticResource Nav}" />
                        <Button Content="Ventas" Command="{Binding GoSales}" Style="{StaticResource Nav}" />
                        <Button Content="Despacho en tienda" Command="{Binding GoDispatch}" Style="{StaticResource Nav}" />
                        <Button Content="Productos" Command="{Binding GoCatalog}" Style="{StaticResource Nav}" />
                        <Button Content="Inventario" Command="{Binding GoInventory}" Style="{StaticResource Nav}" />
                        <Button Content="Compras y proveedores" Command="{Binding GoPurchases}" Style="{StaticResource Nav}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="24,21,24,18">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Feedback}" />
            </StackPanel>
            <ContentControl Content="{Binding Page}" />
        </DockPanel>
    </Grid>
</UserControl>
