<UserControl x:Class="Comercium.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="174" Margin="0,0,9,7">
                        <TextBlock Text="Reporte" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" DisplayMemberPath="Name" AutomationProperties.Name="Tipo de reporte" />
                    </StackPanel>
                    <StackPanel Width="165" Margin="0,0,9,7">
                        <TextBlock Text="Categoría" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" AutomationProperties.Name="Categoría" />
                    </StackPanel>
                    <StackPanel Width="119" Margin="0,0,9,7">
                        <TextBlock Text="Desde" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding From}" MinHeight="34" AutomationProperties.Name="Fecha inicial" />
                    </StackPanel>
                    <StackPanel Width="119" Margin="0,0,9,7">
                        <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding Through}" MinHeight="34" AutomationProperties.Name="Fecha final" />
                    </StackPanel>
                    <Button Content="Aplicar" Command="{Binding Apply}" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="Hoy" Command="{Binding Daily}" Margin="0,0,7,0" />
                    <Button Content="Esta semana" Command="{Binding Weekly}" Margin="0,0,7,0" />
                    <Button Content="Este mes" Command="{Binding Monthly}" />
                </WrapPanel>
                <StackPanel Visibility="{Binding Analysis, Converter={StaticResource VisibleWhen}}" Margin="0,13,0,0">
                    <TextBlock Text="{Binding Overview}" Style="{StaticResource Hint}" />
                    <TextBlock Text="Consulta comercial" Style="{StaticResource FieldLabel}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Consultar" Command="{Binding Ask}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pregunta comercial" MaxLength="300">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Ask}" /></TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Text="Ejemplo · ¿Cuánto vendí hoy?" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Answer}" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Feedback}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,11">
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Content="PDF" Command="{Binding Pdf}" Margin="0,0,7,0" />
                        <Button Content="Excel" Command="{Binding Excel}" />
                    </WrapPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Section}" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="True" AutoGeneratingColumn="BindReportColumn" AutomationProperties.Name="Resultados del reporte" />
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
