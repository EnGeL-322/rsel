<UserControl x:Class="Comercium.App.Views.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="264" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="2*" /><RowDefinition Height="12" /><RowDefinition Height="3*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sesiones de caja" Style="{StaticResource Section}" />
                <DataGrid ItemsSource="{Binding Shifts}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Sesiones de caja">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Caja" Binding="{Binding Id}" Width="55" />
                        <DataGridTextColumn Header="Apertura" Binding="{Binding OpenedUtc, Converter={StaticResource Display}}" Width="127" />
                        <DataGridTextColumn Header="Cierre" Binding="{Binding ClosedUtc, Converter={StaticResource Display}}" Width="127" />
                        <DataGridTextColumn Header="Inicial" Binding="{Binding Opening, Converter={StaticResource Display}, ConverterParameter=money}" Width="85" />
                        <DataGridTextColumn Header="Esperado" Binding="{Binding Expected, Converter={StaticResource Display}, ConverterParameter=money}" Width="85" />
                        <DataGridTextColumn Header="Contado" Binding="{Binding Counted, Converter={StaticResource Display}, ConverterParameter=money}" Width="85" />
                        <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference, Converter={StaticResource Display}, ConverterParameter=money}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Movimientos de la sesión" Style="{StaticResource Section}" />
                <DataGrid ItemsSource="{Binding Entries}" AutomationProperties.Name="Movimientos de caja">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding AtUtc, Converter={StaticResource Display}}" Width="125" />
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="91" />
                        <DataGridTextColumn Header="Importe" Binding="{Binding Amount, Converter={StaticResource Display}, ConverterParameter=money}" Width="93" />
                        <DataGridTextColumn Header="Concepto" Binding="{Binding Note}" Width="*" MinWidth="90" />
                        <DataGridTextColumn Header="Usuario" Binding="{Binding User}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding State}" Style="{StaticResource Section}" />
                    <TextBlock Text="Saldo inicial (S/)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Opening, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Saldo inicial" />
                    <Button Content="Abrir caja" Command="{Binding Open}" Style="{StaticResource Primary}" Margin="0,8,0,0" />
                    <Separator Margin="0,15,0,5" />
                    <TextBlock Text="Tipo de movimiento" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Tipo de movimiento" />
                    <TextBlock Text="Importe (S/)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Importe del movimiento" />
                    <TextBlock Text="Concepto" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="250" AutomationProperties.Name="Concepto" />
                    <Button Content="Registrar movimiento" Command="{Binding Move}" Margin="0,8,0,0" />
                    <Separator Margin="0,15,0,5" />
                    <TextBlock Text="Efectivo contado (S/)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Counted, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Efectivo contado" />
                    <Button Content="Cerrar caja" Command="{Binding Close}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Feedback}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
