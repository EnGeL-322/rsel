<UserControl x:Class="Comercium.App.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Feedback}" />
        <TabControl Background="Transparent" BorderBrush="{StaticResource Line}">
            <TabItem Header="Recibir mercadería" Padding="12,8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="13">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,9">
                                <TextBlock Text="Productos recibidos" Style="{StaticResource Section}" Margin="0,0,0,7" />
                                <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" DisplayMemberPath="Name" AutomationProperties.Name="Producto recibido" />
                                <WrapPanel Margin="0,7,0,0">
                                    <TextBlock Text="Cantidad" VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="49" AutomationProperties.Name="Cantidad recibida" />
                                    <TextBlock Text="Costo unitario (S/)" VerticalAlignment="Center" Margin="8,0,5,0" />
                                    <TextBox Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Width="73" AutomationProperties.Name="Costo unitario" />
                                    <Button Content="Agregar o actualizar" Command="{Binding Add}" Margin="6,0,0,0" />
                                </WrapPanel>
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
                                <TextBlock Text="{Binding Total}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource Blue}" Margin="0,0,9,0" />
                                <Button Content="Quitar línea" Command="{Binding Remove}" Margin="0,0,5,0" />
                                <Button Content="Confirmar recepción" Command="{Binding Receive}" Style="{StaticResource Primary}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedLine}" AutomationProperties.Name="Detalle de la nueva compra">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Product.Name}" Width="*" MinWidth="85" />
                                    <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="55" />
                                    <DataGridTextColumn Header="Costo" Binding="{Binding UnitCost, Converter={StaticResource Display}, ConverterParameter=money}" Width="75" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource Display}, ConverterParameter=money}" Width="85" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="13">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Proveedor" Style="{StaticResource Section}" Margin="0,0,0,7" />
                                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Supplier}" DisplayMemberPath="Name" AutomationProperties.Name="Proveedor" />
                                <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Nombre del proveedor" />
                                <TextBlock Text="Teléfono (opcional)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SupplierPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Teléfono del proveedor" />
                                <WrapPanel Margin="0,7,0,0">
                                    <Button Content="Nuevo proveedor" Command="{Binding NewSupplier}" Margin="0,0,5,0" />
                                    <Button Content="Guardar proveedor" Command="{Binding SaveSupplier}" />
                                </WrapPanel>
                                <TextBlock Text="Referencia de compra (opcional)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Referencia de compra" />
                                <TextBlock Text="Último costo por proveedor" Style="{StaticResource Section}" Margin="0,16,0,7" />
                                <DataGrid ItemsSource="{Binding Costs}" Height="125" AutomationProperties.Name="Comparación de costos">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Proveedor" Binding="{Binding Supplier}" Width="*" MinWidth="85" />
                                        <DataGridTextColumn Header="Costo" Binding="{Binding UnitCost, Converter={StaticResource Display}, ConverterParameter=money}" Width="75" />
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding AtUtc, Converter={StaticResource Display}}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Historial y pagos" Padding="12,8">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="10" /><RowDefinition /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="13">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Top" Content="Solo compras con saldo pendiente" IsChecked="{Binding OutstandingOnly}" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedPurchase}" AutomationProperties.Name="Historial de compras">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Compra" Binding="{Binding Id}" Width="63" />
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding AtUtc, Converter={StaticResource Display}}" Width="123" />
                                    <DataGridTextColumn Header="Proveedor" Binding="{Binding Supplier}" Width="*" MinWidth="85" />
                                    <DataGridTextColumn Header="Referencia" Binding="{Binding Reference}" Width="*" MinWidth="75" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource Display}, ConverterParameter=money}" Width="83" />
                                    <DataGridTextColumn Header="Pendiente" Binding="{Binding Outstanding, Converter={StaticResource Display}, ConverterParameter=money}" Width="83" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="13">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <TextBlock Text="Pago (S/)" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Width="79" AutomationProperties.Name="Importe del pago" />
                                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" Width="118" Margin="6,0" AutomationProperties.Name="Método de pago al proveedor" />
                                <Button Content="Registrar pago" Command="{Binding Pay}" Style="{StaticResource Primary}" />
                            </WrapPanel>
                            <TabControl>
                                <TabItem Header="Productos de la compra">
                                    <DataGrid ItemsSource="{Binding Detail.Items}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="85" />
                                            <DataGridTextColumn Header="Producto" Binding="{Binding Product}" Width="*" />
                                            <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="60" />
                                            <DataGridTextColumn Header="Costo" Binding="{Binding UnitCost, Converter={StaticResource Display}, ConverterParameter=money}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Pagos registrados">
                                    <DataGrid ItemsSource="{Binding Detail.Payments}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Fecha" Binding="{Binding AtUtc, Converter={StaticResource Display}}" Width="*" />
                                            <DataGridTextColumn Header="Método" Binding="{Binding Method}" Width="120" />
                                            <DataGridTextColumn Header="Pago" Binding="{Binding Amount, Converter={StaticResource Display}, ConverterParameter=money}" Width="90" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                            </TabControl>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
