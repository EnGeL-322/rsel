<UserControl x:Class="Comercium.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Feedback}" />
        <TabControl Background="Transparent" BorderBrush="{StaticResource Line}">
            <TabItem Header="Nueva venta" Padding="14,8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="13">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Buscar" Command="{Binding Search}" Margin="6,0,0,0" />
                                <TextBox Text="{Binding Term, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar por nombre o código">
                                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Search}" /></TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,7,0,0">
                                <TextBlock Text="Cantidad" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="47" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad para agregar" />
                                <CheckBox Content="Mayorista" IsChecked="{Binding Wholesale}" VerticalAlignment="Center" Margin="8,0" />
                                <Button Content="Agregar al carrito" Command="{Binding Add}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutomationProperties.Name="Productos disponibles">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="100" />
                                    <DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="70" />
                                    <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="52" />
                                    <DataGridTextColumn Header="Minorista" Binding="{Binding Retail, Converter={StaticResource Display}, ConverterParameter=money}" Width="81" />
                                    <DataGridTextColumn Header="Mayorista" Binding="{Binding Wholesale, Converter={StaticResource Display}, ConverterParameter=money}" Width="81" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="13">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Carrito" Style="{StaticResource Section}" Margin="0,0,0,7" />
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,7,0,0">
                                <TextBlock Text="Cantidad" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Width="47" Text="{Binding CartQuantity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cantidad de la línea seleccionada" />
                                <Button Content="Actualizar línea" Command="{Binding UpdateQuantity}" Margin="7,0" />
                                <Button Content="Quitar" Command="{Binding Remove}" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedItem}" AutomationProperties.Name="Carrito">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*" MinWidth="95" />
                                    <DataGridTextColumn Header="Tarifa" Binding="{Binding Tariff}" Width="77" />
                                    <DataGridTextColumn Header="Cant." Binding="{Binding Quantity}" Width="54" />
                                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, Converter={StaticResource Display}, ConverterParameter=money}" Width="85" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Cobro" Style="{StaticResource Section}" />
                                <TextBlock Text="Cliente" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding CustomerOptions}" SelectedItem="{Binding Customer}" DisplayMemberPath="Name" AutomationProperties.Name="Cliente de la venta" Margin="0,0,0,8" />
                                <TextBlock Text="Subtotal" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding SubtotalText}" FontWeight="SemiBold" />
                                <TextBlock Text="Descuento (S/)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanDiscount}" AutomationProperties.Name="Descuento" />
                                <TextBlock Text="Método de pago" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" AutomationProperties.Name="Método de pago" />
                                <StackPanel Visibility="{Binding IsCash, Converter={StaticResource VisibleWhen}}">
                                    <TextBlock Text="Efectivo recibido (S/)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Received, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Efectivo recibido" />
                                    <Button Content="Importe exacto" Command="{Binding ExactCash}" Margin="0,5,0,0" />
                                    <TextBlock Text="Cambio" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ChangeText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CashStatus}" Style="{StaticResource Hint}" FontSize="12" Margin="0,6,0,0" />
                                </StackPanel>
                                <TextBlock Text="Total" Style="{StaticResource FieldLabel}" Margin="0,15,0,2" />
                                <TextBlock Text="{Binding TotalText}" FontSize="24" Foreground="{StaticResource Blue}" FontWeight="Bold" />
                                <Button Content="Confirmar venta" Command="{Binding Confirm}" Style="{StaticResource Primary}" Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Historial" Padding="14,8">
                <Border Style="{StaticResource Card}" Margin="8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="Historial de ventas" Style="{StaticResource Section}" />
                            <WrapPanel>
                                <TextBlock Text="Venta, cliente o documento" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding HistoryTerm, UpdateSourceTrigger=PropertyChanged}" Width="145" AutomationProperties.Name="Venta, cliente o documento" />
                                <DatePicker SelectedDate="{Binding HistoryFrom}" Width="119" Margin="6,0,0,0" AutomationProperties.Name="Fecha inicial" />
                                <DatePicker SelectedDate="{Binding HistoryThrough}" Width="119" Margin="6,0,0,0" AutomationProperties.Name="Fecha final" />
                                <Button Content="Filtrar" Command="{Binding FindSales}" Margin="6,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button Content="Ver comprobante" Command="{Binding ViewReceipt}" Margin="0,0,6,0" />
                            <Button Content="Guardar PDF" Command="{Binding SaveReceipt}" Margin="0,0,6,0" />
                            <Button Content="Imprimir comprobante" Command="{Binding PrintReceipt}" Margin="0,0,14,0" />
                            <TextBlock Text="Motivo de anulación" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Width="150" Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="250" AutomationProperties.Name="Motivo de anulación" />
                            <Button Content="Anular venta" Command="{Binding VoidSale}" Foreground="{StaticResource Red}" Margin="6,0,0,0" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedSale}" AutomationProperties.Name="Historial de ventas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Venta" Binding="{Binding Id}" Width="75" />
                                <DataGridTextColumn Header="Fecha" Binding="{Binding AtUtc, Converter={StaticResource Display}}" Width="*" />
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Customer}" Width="*" />
                                <DataGridTextColumn Header="Pago" Binding="{Binding Method}" Width="110" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource Display}, ConverterParameter=money}" Width="115" />
                                <DataGridTextColumn Header="Estado" Binding="{Binding Voided, Converter={StaticResource Display}, ConverterParameter=sale}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
