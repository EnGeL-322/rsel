<UserControl x:Class="Comercium.App.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="390" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Section}" />
                <TextBlock Text="Contraseña actual" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="Current" MaxLength="128" AutomationProperties.Name="Contraseña actual" />
                <TextBlock Text="Contraseña nueva" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="Replacement" MaxLength="128" AutomationProperties.Name="Contraseña nueva" />
                <TextBlock Text="Confirmar contraseña nueva" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="Confirmation" MaxLength="128" AutomationProperties.Name="Confirmar contraseña nueva" />
                <Button Content="Cambiar contraseña" Click="Change" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                <StackPanel Visibility="{Binding CanBackUp, Converter={StaticResource VisibleWhen}}" Margin="0,21,0,0">
                    <Separator Margin="0,0,0,12" />
                    <TextBlock Text="Copias de seguridad" Style="{StaticResource Section}" />
                    <WrapPanel>
                        <Button Content="Crear respaldo" Command="{Binding CreateBackup}" Margin="0,0,7,0" />
                        <Button Content="Restaurar respaldo" Command="{Binding RestoreBackup}" />
                    </WrapPanel>
                </StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Feedback}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
