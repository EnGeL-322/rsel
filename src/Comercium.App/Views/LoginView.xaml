<UserControl x:Class="Comercium.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Navy}" Padding="44">
            <StackPanel VerticalAlignment="Center">
                <Border CornerRadius="12" Background="#2178D7" Width="54" Height="54" HorizontalAlignment="Left">
                    <TextBlock Text="C" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Comercium" Foreground="White" FontSize="36" FontWeight="SemiBold" Margin="0,18,0,10" />
                <TextBlock Text="Ventas, inventario y despacho para tu tienda." Foreground="#B7D6F6" FontSize="19" MaxWidth="280" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
            <Border Style="{StaticResource Card}" Width="385" Padding="30" Margin="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Introduction}" Style="{StaticResource Hint}" Margin="0,6,0,17" />
                    <StackPanel Visibility="{Binding Setup, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Nombre" />
                    </StackPanel>
                    <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Usuario" />
                    <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="Secret" MaxLength="128" AutomationProperties.Name="Contraseña" />
                    <StackPanel Visibility="{Binding Setup, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Usa al menos 12 caracteres." Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <TextBlock Text="Confirmar contraseña" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="Confirmation" MaxLength="128" AutomationProperties.Name="Confirmar contraseña" />
                    </StackPanel>
                    <Button Content="{Binding Button}" Style="{StaticResource Primary}" IsDefault="True" Click="Submit" Margin="0,19,0,0" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Feedback}" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
