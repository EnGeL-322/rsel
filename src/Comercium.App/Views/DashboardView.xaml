<UserControl x:Class="Comercium.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,5">
            <Button Content="Nueva venta" Command="{Binding NewSale}" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Metrics}" Margin="-4,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="4" Padding="15">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource Blue}" FontSize="24" FontWeight="Bold" Margin="0,3,0,3" />
                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Hint}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Margin="0,9,0,12">
                <StackPanel>
                    <TextBlock Text="Ventas de los últimos 7 días" Style="{StaticResource Section}" />
                    <charts:CartesianChart Height="205" Series="{Binding Series}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                           Visibility="{Binding HasWeeklySales, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="Las ventas confirmadas aparecerán aquí." Style="{StaticResource Hint}" Margin="0,0,0,12"
                               Visibility="{Binding EmptyWeek, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Pedidos por entregar" Style="{StaticResource Section}" />
                        <TextBlock Text="{Binding Pending}" Foreground="{StaticResource Blue}" FontSize="27" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Más vendidos este mes" Style="{StaticResource Section}" />
                        <TextBlock Text="Aún no hay ventas confirmadas este mes." Style="{StaticResource Hint}"
                                   Visibility="{Binding EmptyBestSellers, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding BestSellers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Quantity}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Compras recientes" Style="{StaticResource Section}" />
                    <TextBlock Text="Aún no hay compras registradas." Style="{StaticResource Hint}"
                               Visibility="{Binding EmptyPurchases, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding RecentPurchases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total, Converter={StaticResource Display}, ConverterParameter=money}" FontWeight="SemiBold" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AtUtc, Converter={StaticResource Display}}" Style="{StaticResource Hint}" Margin="9,0,18,0" />
                                    <TextBlock Text="{Binding Supplier}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
