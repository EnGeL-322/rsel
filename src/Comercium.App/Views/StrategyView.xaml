<UserControl x:Class="Comercium.App.Views.StrategyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Style="{StaticResource Feedback}" />
        <TabControl Background="Transparent" BorderBrush="{StaticResource Line}">
            <TabItem Header="Identidad y FODA" Padding="12,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,10,8">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Height="75" MaxLength="4000" AcceptsReturn="True"
                                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Guardar identidad y FODA" Command="{Binding SaveProfile}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Objetivos y mediciones" Padding="12,8">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="255" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="12" /><RowDefinition /></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Nuevo objetivo" Command="{Binding New}" />
                                <TextBlock Text="Objetivos" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Goals}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Objetivos estratégicos">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Objetivo" Binding="{Binding Name}" Width="*" MinWidth="110" />
                                    <DataGridTextColumn Header="Indicador" Binding="{Binding Indicator}" Width="*" MinWidth="95" />
                                    <DataGridTextColumn Header="Meta" Binding="{Binding Target}" Width="65" />
                                    <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="71" />
                                    <DataGridTextColumn Header="Fecha límite" Binding="{Binding Due, StringFormat=dd/MM/yyyy}" Width="101" />
                                    <DataGridCheckBoxColumn Header="Cumplido" Binding="{Binding Completed, Mode=OneWay}" Width="79" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Progress}" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,7,0,0">
                                <TextBlock Text="Valor" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="60" AutomationProperties.Name="Valor de medición" />
                                <TextBlock Text="Nota" VerticalAlignment="Center" Margin="7,0,5,0" />
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="115" MaxLength="4000" AutomationProperties.Name="Nota de medición" />
                                <Button Content="Registrar medición" Command="{Binding Measure}" Margin="6,0,0,0" />
                            </WrapPanel>
                            <DataGrid ItemsSource="{Binding Readings}" AutomationProperties.Name="Mediciones del indicador">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding AtUtc, Converter={StaticResource Display}}" Width="120" />
                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="70" />
                                    <DataGridTextColumn Header="Nota" Binding="{Binding Note}" Width="*" MinWidth="65" />
                                    <DataGridTextColumn Header="Usuario" Binding="{Binding User}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Ficha del objetivo" Style="{StaticResource Section}" />
                                <TextBlock Text="Objetivo" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Form.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="140" AutomationProperties.Name="Objetivo" />
                                <TextBlock Text="Indicador" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Form.Indicator, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Indicador" />
                                <TextBlock Text="Unidad de medida" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Form.Unit, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Unidad del indicador" />
                                <TextBlock Text="Meta" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Form.Target, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Meta" />
                                <TextBlock Text="Fecha límite" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding Form.Due}" AutomationProperties.Name="Fecha límite del objetivo" />
                                <TextBlock Text="Estrategia" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Form.Strategy, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" MaxLength="4000" AutomationProperties.Name="Estrategia" />
                                <TextBlock Text="Evaluación" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Form.Evaluation, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" MaxLength="4000" AutomationProperties.Name="Evaluación" />
                                <CheckBox Content="Objetivo cumplido" IsChecked="{Binding Form.Completed}" Margin="0,9,0,0" />
                                <Button Content="Guardar objetivo" Command="{Binding SaveGoal}" Style="{StaticResource Primary}" Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
